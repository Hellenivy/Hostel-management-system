# Copy this file to .env (same folder) and fill in your own values.
# Never commit the real .env.

DJANGO_SECRET_KEY=
# True only on your own machine
DJANGO_DEBUG=False
# Extra hostnames, comma-separated (e.g. your ngrok domain)
DJANGO_ALLOWED_HOSTS=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=
# Long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_TOKEN=

# Africa's Talking SMS (use "sandbox" while testing)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
